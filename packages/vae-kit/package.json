{
  "name": "dsh-vae-kit",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: personal MCP + Skill catalog with global and project enablement",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "kit",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veaaae/dsh-vae-plugin.git",
    "directory": "packages/vae-kit"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "tsdown && node --test tests/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  }
}
