{
  "name": "dsh-vae-status",
  "version": "0.1.0",
  "description": "Canary DeepSeek Harness tool that reports this plugin is loaded",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veaaae/dsh-vae-plugin.git",
    "directory": "packages/vae-status"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "tsdown && node --test tests/greeting.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  }
}
